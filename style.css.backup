:root {
    --text-primary: #ffffff;
    --text-secondary: #dddddd;
    --accent: #ffb347;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Outfit', sans-serif;
}

body {
    /* Realistic Sunset / Dusk Sky Gradient */
    background: linear-gradient(to bottom, #0d233a 0%, #446d88 50%, #ffb347 100%);
    color: var(--text-primary);
    overflow: hidden; /* hide scrollbars for full screen hero */
    width: 100vw;
    height: 100vh;
}

/* Navbar */
.navbar {
    position: absolute;
    top: 0;
    width: 100%;
    padding: 2rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
}

.logo {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 2px;
}

nav a {
    color: var(--text-primary);
    text-decoration: none;
    margin-left: 2rem;
    font-weight: 400;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
}

nav a:hover {
    color: var(--accent);
}

/* Hero Section */
.hero {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 4rem;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
}

.hero-title {
    font-size: 5rem;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    opacity: 0; /* For GSAP */
    transform: translateY(30px);
}

.hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    font-weight: 300;
    opacity: 0; /* For GSAP */
    transform: translateY(30px);
}

.hero-cta {
    padding: 1rem 2.5rem;
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid var(--text-primary);
    border-radius: 30px;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0; /* For GSAP */
    transform: translateY(30px);
}

.hero-cta:hover {
    background-color: var(--text-primary);
    color: var(--bg-color);
}

/* Three.js Canvas Container */
#canvas-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}
